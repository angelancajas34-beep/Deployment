# ─── TeleBotHost Environment ──────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: Your Telegram bot token from @BotFather
BOT_TOKEN=

# Required: A random secret string used to validate webhook requests from Telegram.
# Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=

# Required: Your Telegram user ID. Used to gate owner-only commands.
# Find yours by messaging @userinfobot
OWNER_ID=

# Optional: Port the HTTP server listens on. Defaults to 8000.
PORT=8000

# Optional: Runtime environment label. Affects log output.
# Values: production | development
ENV=production

# Required when registering the webhook (run src/webhook.ts once after deploy):
# The public HTTPS URL of your deployment, without trailing slash.
# Example: https://your-project.deno.dev
PUBLIC_URL=
